# ───────────────────────────── Ex Libris Video ─────────────────────────────
# Copy to .env.local for local development. On Coolify set these as
# Environment Variables on BOTH the web and the worker application.

# PostgreSQL (Coolify: copy the "Internal URL" of the Postgres resource)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/exlibris

# Public URL without trailing slash – used in links, e-mails and QR codes
APP_URL=https://www.exlibrisvideo.hu

# Shared storage (Coolify: Directory bind mount to /app/storage on web AND worker)
STORAGE_DIR=/app/storage

# Long random string (e.g. `openssl rand -hex 32`) – signs owner / PIN cookies
APP_SECRET=change-me

# ── AI ────────────────────────────────────────────────────────────────────────
# auto = anthropic if ANTHROPIC_API_KEY is set, else deepseek if DEEPSEEK_API_KEY, else mock
AI_PROVIDER=auto
AI_TEXT_PROVIDER=auto
AI_MOCK=false
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-opus-5
ANTHROPIC_TEXT_MODEL=claude-opus-5
ANTHROPIC_VISION_EFFORT=medium
ANTHROPIC_TEXT_EFFORT=low
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash

# ── Video pipeline ────────────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FRAME_SAMPLE_FPS=8
KEYFRAME_WINDOW_SEC=0.33
MAX_FRAMES_PER_VIDEO=120
FRAME_MAX_EDGE=1920
VISION_BATCH_SIZE=4
VISION_CONCURRENCY=2
DELETE_SOURCE_AFTER_PROCESSING=true

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=1024
MAX_VIDEO_SECONDS=600
MAX_SOURCES_PER_COLLECTION=30
MAX_BOOKS_PER_COLLECTION=5000
UPLOAD_CHUNK_MB=8
RATE_COLLECTIONS_PER_IP_DAY=20
RATE_UPLOADS_PER_IP_HOUR=60
RATE_EMAILS_PER_COLLECTION_DAY=5

# ── Enrichment ────────────────────────────────────────────────────────────────
ENRICH_COVERS=true
GOOGLE_BOOKS_API_KEY=

# ── E-mail: smtp | resend | console ───────────────────────────────────────────
EMAIL_PROVIDER=console
EMAIL_FROM=Ex Libris Video <hello@exlibrisvideo.hu>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
RESEND_API_KEY=

# ── Worker ────────────────────────────────────────────────────────────────────
WORKER_POLL_MS=1500
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_GRACE_MS=20000
WORKER_STALE_JOB_MS=300000
DRAFT_RETENTION_DAYS=7

# ── Admin (/api/admin/overview, Basic auth user "admin") ──────────────────────
ADMIN_PASSWORD=

# ── Optional public settings ──────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_COLLECTION_ID=
